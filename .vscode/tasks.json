{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compilar",
            "detail": "Chama o Makefile na raiz: compila TODOS os .c do projeto.",
            "type": "shell",
            "command": "make",
            "windows": {
                "command": "mingw32-make"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "executar",
            "detail": "Compila e roda build/programa.exe. E' o Ctrl+Shift+B.",
            "type": "shell",
            "command": "make",
            "windows": {
                "command": "mingw32-make"
            },
            "args": [
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "limpar",
            "detail": "Apaga a pasta build.",
            "type": "shell",
            "command": "make",
            "windows": {
                "command": "mingw32-make"
            },
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}